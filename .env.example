# ===== Kelajak markazi — muhit o‘zgaruvchilari =====
# Bu faylni .env nomi bilan nusxalang va qiymatlarni to‘ldiring.

# Ma’lumotlar bazasi. PostgreSQL ulanmasa, avtomatik SQLite (backend/kelajak.db) ishlatiladi.
DATABASE_URL=postgresql://kelajak:kelajak@localhost:5432/kelajak
# SQLite uchun: DATABASE_URL=sqlite:///./kelajak.db

# JWT maxfiy kaliti — albatta o‘zgartiring (masalan: openssl rand -hex 32)
SECRET_KEY=bu-yerga-uzun-tasodifiy-qator-yozing
ACCESS_TOKEN_HOURS=24

# Groq AI (https://console.groq.com) — kalit faqat serverda saqlanadi
GROQ_API_KEY=bu-yerga-groq-api-kalitini-yozing
GROQ_MODEL=openai/gpt-oss-120b

# Birinchi administrator (seed vaqtida yaratiladi) — parolni o‘zgartiring!
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=Admin12345!
ADMIN_NAME=Administrator

# CORS va sayt manzili (sitemap.xml uchun)
CORS_ORIGINS=http://localhost:5173,http://localhost:8080
SITE_URL=http://localhost:8080

# Docker Compose uchun PostgreSQL
POSTGRES_USER=kelajak
POSTGRES_PASSWORD=kelajak
POSTGRES_DB=kelajak
